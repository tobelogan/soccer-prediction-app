# Copy these values into Streamlit Community Cloud -> App settings -> Secrets.
# Do NOT commit a real .streamlit/secrets.toml file.
PUBLIC_APP = "true"

# Recommended when the model is too large for normal GitHub storage.
# Must be a DIRECT download URL to the .joblib bytes.
MODEL_URL = ""

# Optional but strongly recommended. Generate locally with:
# python -c "import hashlib; p='models/top5_5000_each_v11.joblib'; print(hashlib.sha256(open(p,'rb').read()).hexdigest())"
MODEL_SHA256 = ""

# Optional structured live-data provider token.
SPORTMONKS_API_TOKEN = ""
